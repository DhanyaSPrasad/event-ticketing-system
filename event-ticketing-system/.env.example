MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=event_ticketing

# Separate MySQL accounts created by database/rbac.sql
MYSQL_ADMIN_USER=ets_admin
MYSQL_ADMIN_PASSWORD=replace_with_admin_password
MYSQL_CUSTOMER_USER=ets_customer
MYSQL_CUSTOMER_PASSWORD=replace_with_customer_password
MYSQL_AUTH_USER=ets_auth
MYSQL_AUTH_PASSWORD=replace_with_auth_password

# Temporary fallback only; remove after role accounts are configured.
# MYSQL_USER=root
# MYSQL_PASSWORD=replace_me

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=event_ticketing
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Demo accounts are created by database/seed.sql / npm run seed:users.
