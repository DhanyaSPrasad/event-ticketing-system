# MySQL (required)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=event_ticketing

# MongoDB (optional for metadata search)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=event_ticketing

# Set a long random secret for signed login cookies
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Demo admin/customer accounts are created by database/seed.sql.
# The seed uses a bcrypt hash for password: Demo123!
